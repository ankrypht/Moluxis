# EAS Build ignore file

# Dependencies
node_modules/

# Git
.git/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# Debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# Local env files
.env*.local

# TypeScript
*.tsbuildinfo

# Generated native folder
/android

# Documentation
docs/
CHANGELOG.md
LICENSE
README.md

# Tests
**/__tests__/**
**/__snapshots__/**

# VS Code
.vscode/

.antigravitycli

# Google Play API credentials and reports
*service-account*.json
play-key.json
play-reports/

# Maintenance scripts (not needed in production app bundle)
scripts/

# CI/CD and linter configs
.github/
eslint.config.js
.prettierignore
