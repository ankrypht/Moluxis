{
  "name": "moluxis",
  "version": "2.1.1",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "lint": "expo lint",
    "doctor": "npx expo-doctor@latest",
    "build": "npm install -g eas-cli@latest && eas build --platform android --profile preview --local",
    "build-eas": "npm install -g eas-cli@latest && eas build --platform android --profile preview",
    "build-prod": "npm install -g eas-cli@latest && eas build --platform android --profile production --local",
    "build-prod-eas": "npm install -g eas-cli@latest && eas build --platform android --profile production",
    "build-dev": "npm install -g eas-cli@latest && eas build --platform android --profile development --local",
    "build-dev-eas": "npm install -g eas-cli@latest && eas build --platform android --profile development",
    "format": "npx prettier@latest --write .",
    "test": "jest",
    "fetch-anrs": "node scripts/fetch-anrs.mjs",
    "fetch-crashes": "node scripts/fetch-anrs.mjs --type CRASH",
    "fetch-vitals": "node scripts/fetch-vitals.mjs"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~58.0.14",
    "expo-build-properties": "~58.0.11",
    "expo-dev-client": "~58.0.14",
    "expo-file-system": "~58.0.9",
    "expo-font": "~58.0.8",
    "expo-haptics": "~58.0.7",
    "expo-navigation-bar": "~58.0.4",
    "expo-sharing": "~58.0.19",
    "expo-splash-screen": "~58.0.10",
    "expo-status-bar": "~58.0.3",
    "expo-store-review": "~58.0.2",
    "expo-system-ui": "~58.0.6",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-webview": "14.0.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@react-native/jest-preset": "^0.88.0",
    "@testing-library/react-native": "^12.9.0",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "babel-preset-expo": "^58.0.17",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.11",
    "prettier": "^3.9.10",
    "react-test-renderer": "19.3.0",
    "typescript": "~6.0.3"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "<rootDir>/jest.setup.js"
    ]
  },
  "allowScripts": {
    "unrs-resolver@1.12.2": true,
    "fsevents@2.3.3": true,
    "@parcel/watcher@2.6.0": true
  }
}
